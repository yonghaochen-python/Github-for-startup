ANTHROPIC_API_KEY=
DATABASE_URL="file:./dev.db"

# Try It On (FLUX virtual try-on on fal.ai) is OFF by default; the app shows a labeled prototype.
# To turn it on: (1) create a fal.ai key and put it below (and as a secret named FAL_KEY on the Worker),
# (2) add these two lines inside the env { } block of cloudflare.config.ts, then restart / redeploy:
#       TRYON_PROVIDER: bindings.text("fal-flux-vto"),
#       FAL_KEY: bindings.secret(),
FAL_KEY=

# Or use Black Forest Labs' FLUX virtual try-on directly (whole outfit in one call, shoes/accessories included):
# set TRYON_PROVIDER=bfl-flux-vto and BFL_API_KEY below (on the Worker: TRYON_PROVIDER: bindings.text("bfl-flux-vto")
# and BFL_API_KEY: bindings.secret() in cloudflare.config.ts, plus a BFL_API_KEY secret).
# TRYON_PROVIDER=bfl-flux-vto
BFL_API_KEY=
