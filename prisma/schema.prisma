generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  selfieUrl    String?
  /// The name shown in the app ("Hello, Maya"). Optional and editable; the email stays the login and can't change.
  displayName  String?
  /// "user" for everyone; "admin" only when set directly in the database (no app path changes it).
  role         String    @default("user")
  /// Updated at most hourly from signed-in requests; powers active-user and retention stats.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  /// free | plus | pro (see lib/plans). Only an admin can change it until billing exists.
  plan         String    @default("free")
  /// Start of the person's monthly periods; empty means their sign-up date.
  periodAnchor DateTime?

  items    ClothingItem[]
  outfits  Outfit[]
  sessions Session[]
  events   AnalyticsEvent[]
  resets   PasswordReset[]
  picks    Pick[]
  credits  CreditEntry[]
  reports  StudioReport[]
  feedback Feedback[]
}

/// The credit history: one row per grant, adjustment or use, never deleted. A use is "reserved" while its try-on
/// runs, then "completed" (counted) or "released" (given back). Balances are worked out from these rows (lib/credits).
model CreditEntry {
  id        String    @id @default(cuid())
  userId    String
  /// photo | live (never mixed)
  kind      String
  /// use | adjustment
  type      String
  /// plan (monthly allowance) | extra (added credits) | over (beyond the limit, count-only mode) | admin (exempt)
  source    String
  /// -1 for a use; + or - for an adjustment
  amount    Int
  /// reserved | completed | released
  status    String
  /// e.g. connected, failed, timed_out, not_real (practice mode), token_failed
  outcome   String?
  note      String?
  /// One per user: a repeated request with the same id is never counted twice.
  requestId String
  createdAt DateTime  @default(now())
  settledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, kind, createdAt])
  @@index([status, createdAt])
}

/// One AI Stylist analysis (color, makeup, hair or style) of the person's portrait. Each module keeps its latest
/// reports so people can look back; regenerating adds a new row and never overwrites. "generating" rows also stop
/// a second request for the same module from running at the same time. Token counts and the estimated cost are
/// kept per report for the owner's cost tracking.
model StudioReport {
  id              String    @id @default(cuid())
  userId          String
  /// color | makeup | hair | style (lib/studioModules)
  module          String
  /// generating | ready | failed
  status          String
  /// The report, as JSON (lib/studioModules StudioReportData). Empty until it's ready.
  data            String?
  /// Which portrait it was made from (a short token that changes when the portrait is replaced).
  portraitVersion String?
  /// One per user: a repeated request with the same id is answered once.
  requestId       String
  /// Practice data (no AI, nothing charged).
  practice        Boolean   @default(false)
  inputTokens     Int?
  outputTokens    Int?
  /// Estimated AI cost, in millionths of a US dollar.
  costMicros      Int?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, module, createdAt])
}

/// A person's Good / Bad rating of one result: a photo try-on, a live session, a "Style it" outfit or an AI Stylist
/// report. The first Bad in a monthly period on a real try-on (photo or live) adds 2 photo and 2 live extra credits
/// as a thank-you; later ones (and Bads on outfits or reports) are kept as feedback only.
model Feedback {
  id           String   @id @default(cuid())
  userId       String
  /// photo | live | outfit | stylist
  kind         String
  /// The result rated: the try-on's or live session's request id, the outfit's id, or the report's id.
  targetId     String
  /// good | bad
  rating       String
  /// The start of the monthly period whose thank-you credits this gave (empty otherwise). One per person per period.
  rewardPeriod String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@unique([userId, rewardPeriod])
  @@index([kind, rating, createdAt])
}

/// One usage event for the owner's analytics dashboard: what happened, never any content.
/// No photos, clothing details, emails or error text are stored here.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  ok         Boolean  @default(true)
  durationMs Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([name, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClothingItem {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  category     String
  layeringRole String   @default("mid_layer")
  warmth       String   @default("medium")
  color        String
  pattern      String
  material     String
  formality    String
  season       String
  description  String
  /// The brand, when a logo, label or printed name shows it (or the person typed it). Empty = unknown.
  brand        String?
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
}

model Outfit {
  id         String   @id @default(cuid())
  userId     String
  rationale  String
  isFavorite Boolean  @default(false)
  occasion   String?
  weather    String?
  style      String?
  createdAt  DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OutfitItem[]
}

model OutfitItem {
  outfitId String
  itemId   String

  outfit Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}

/// A one-time password reset link. Only a hash of the link's secret is kept.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// "Share looks": 1–4 try-on pictures shared by link; friends love one look or vote among several. The pictures
/// live in storage under private/picks/<id>/ and are deleted when the link ends (48 hours, or earlier if the owner
/// stops sharing).
model Pick {
  id        String   @id @default(cuid())
  /// The long random code in the share link (/pick/<code>).
  code      String   @unique
  userId    String
  /// The looks' names in order (A, B, C, D), as a JSON array of strings.
  labels    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes PickVote[]

  @@index([userId])
  @@index([expiresAt])
}

/// One friend's vote: which look (0 = A, 1 = B, …); with a single look, 0 means they loved it. voterId is a random
/// id kept in that browser; nothing else about the voter is stored.
model PickVote {
  pickId    String
  voterId   String
  choice    Int
  createdAt DateTime @default(now())

  pick Pick @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@id([pickId, voterId])
  @@index([pickId, choice])
}
