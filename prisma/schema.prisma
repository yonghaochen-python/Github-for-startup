generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  selfieUrl    String?
  /// The name shown in the app ("Hello, Maya"). Optional and editable; the email stays the login and can't change.
  displayName  String?
  /// "user" for everyone; "admin" only when set directly in the database (no app path changes it).
  role         String    @default("user")
  /// Updated at most hourly from signed-in requests; powers active-user and retention stats.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  /// free | plus | pro (see lib/plans). Only an admin can change it until billing exists.
  plan         String    @default("free")
  /// Start of the person's monthly periods; empty means their sign-up date.
  periodAnchor DateTime?
  /// 7-day Plus trial: when it started (set once, never cleared, so one trial per account) and when it ends.
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  /// The Stripe customer for this account (Stripe holds the payment methods; Virm stores only this id).
  stripeCustomerId     String?   @unique
  /// A keyed one-way hash of Stripe's card fingerprint, never the fingerprint itself, the card number or CVC.
  /// Server only (never sent to a browser). A match flags a trial for review; it never blocks it on its own.
  trialCardFingerprint String?
  /// This account's own invite code to share (made the first time it's shown). A friend's code gives a 14-day trial.
  inviteCode           String?   @unique
  /// Whose code this account joined with (that account's id). Set once; empty if no code was used.
  invitedById          String?
  /// Public profile (social feed): the @handle in lowercase (unique; empty until picked), a short bio, and where the
  /// public profile picture is stored (a small square copy, never the private try-on photo). The email is never public.
  username             String?   @unique
  bio                  String?
  avatarKey            String?
  /// May post while posting is limited to testers (admins always can).
  canPost              Boolean   @default(false)

  items    ClothingItem[]
  outfits  Outfit[]
  sessions Session[]
  events   AnalyticsEvent[]
  resets   PasswordReset[]
  picks    Pick[]
  credits  CreditEntry[]
  reports  StudioReport[]
  feedback Feedback[]
  plans    OutfitPlan[]
  subscriptions Subscription[]
  posts         Post[]
  postReports   PostReport[]
  postReactions PostReaction[]
  postSaves     PostSave[]

  @@index([trialCardFingerprint])
  @@index([invitedById])
}

/// The credit history: one row per grant, adjustment or use, never deleted. A use is "reserved" while its try-on
/// runs, then "completed" (counted) or "released" (given back). Balances are worked out from these rows (lib/credits).
model CreditEntry {
  id        String    @id @default(cuid())
  userId    String
  /// photo | live (never mixed)
  kind      String
  /// use | adjustment
  type      String
  /// plan (monthly allowance) | extra (added credits) | over (beyond the limit, count-only mode) | admin (exempt)
  source    String
  /// -1 for a use; + or - for an adjustment
  amount    Int
  /// reserved | completed | released
  status    String
  /// e.g. connected, failed, timed_out, not_real (practice mode), token_failed
  outcome   String?
  note      String?
  /// One per user: a repeated request with the same id is never counted twice.
  requestId String
  createdAt DateTime  @default(now())
  settledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, kind, createdAt])
  @@index([status, createdAt])
}

/// One AI Stylist analysis (color, makeup, hair or style) of the person's portrait. Each module keeps its latest
/// reports so people can look back; regenerating adds a new row and never overwrites. "generating" rows also stop
/// a second request for the same module from running at the same time. Token counts and the estimated cost are
/// kept per report for the owner's cost tracking.
model StudioReport {
  id              String    @id @default(cuid())
  userId          String
  /// color | makeup | hair | style (lib/studioModules)
  module          String
  /// generating | ready | failed
  status          String
  /// The report, as JSON (lib/studioModules StudioReportData). Empty until it's ready.
  data            String?
  /// Which portrait it was made from (a short token that changes when the portrait is replaced).
  portraitVersion String?
  /// One per user: a repeated request with the same id is answered once.
  requestId       String
  /// Practice data (no AI, nothing charged).
  practice        Boolean   @default(false)
  inputTokens     Int?
  outputTokens    Int?
  /// Estimated AI cost, in millionths of a US dollar.
  costMicros      Int?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, module, createdAt])
}

/// A person's Good / Bad rating of one result: a photo try-on, a live session, a "Style it" outfit or an AI Stylist
/// report. The first Bad in a monthly period on a real try-on (photo or live) adds 2 photo and 2 live extra credits
/// as a thank-you; later ones (and Bads on outfits or reports) are kept as feedback only.
model Feedback {
  id           String   @id @default(cuid())
  userId       String
  /// photo | live | outfit | stylist
  kind         String
  /// The result rated: the try-on's or live session's request id, the outfit's id, or the report's id.
  targetId     String
  /// good | bad
  rating       String
  /// The start of the monthly period whose thank-you credits this gave (empty otherwise). One per person per period.
  rewardPeriod String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@unique([userId, rewardPeriod])
  @@index([kind, rating, createdAt])
}

/// One usage event for the owner's analytics dashboard: what happened, never any content.
/// No photos, clothing details, emails or error text are stored here.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  ok         Boolean  @default(true)
  durationMs Int?
  /// The real AI cost of this event in millionths of a dollar (Claude calls only, from its token counts).
  costMicros Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([name, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClothingItem {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  category     String
  layeringRole String   @default("mid_layer")
  warmth       String   @default("medium")
  color        String
  pattern      String
  material     String
  formality    String
  season       String
  description  String
  /// The brand, when a logo, label or printed name shows it (or the person typed it). Empty = unknown.
  brand        String?
  /// AI enhancement (admins only for now): the picture shown before enhancing (photo or cut-out), kept as it is.
  plainUrl     String?
  /// The AI-tidied picture. imageUrl is whichever of the two is shown; switching never makes a new one.
  enhancedUrl  String?
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
  postItems   PostItem[]
}

model Outfit {
  id         String   @id @default(cuid())
  userId     String
  rationale  String
  isFavorite Boolean  @default(false)
  occasion   String?
  weather    String?
  style      String?
  createdAt  DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OutfitItem[]
}

model OutfitItem {
  outfitId String
  itemId   String

  outfit Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}

/// A one-time password reset link. Only a hash of the link's secret is kept.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// "Share looks": 1–4 try-on pictures shared by link; friends love one look or vote among several. The pictures
/// live in storage under private/picks/<id>/ and are deleted when the link ends (48 hours, or earlier if the owner
/// stops sharing).
model Pick {
  id        String   @id @default(cuid())
  /// The long random code in the share link (/pick/<code>).
  code      String   @unique
  userId    String
  /// The looks' names in order (A, B, C, D), as a JSON array of strings.
  labels    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes PickVote[]

  @@index([userId])
  @@index([expiresAt])
}

/// One friend's vote: which look (0 = A, 1 = B, …); with a single look, 0 means they loved it. voterId is a random
/// id kept in that browser; nothing else about the voter is stored.
model PickVote {
  pickId    String
  voterId   String
  choice    Int
  createdAt DateTime @default(now())

  pick Pick @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@id([pickId, voterId])
  @@index([pickId, choice])
}

/// A month of planned outfits (Planner). One row per person per month; days is JSON:
/// { "2026-11-06": { "items": ["<clothing id>", ...], "source": "generated" | "edited" }, ... }.
/// Pieces deleted from the closet are simply left out when read. Not a saved look.
model OutfitPlan {
  id        String   @id @default(cuid())
  userId    String
  /// "2026-11"
  month     String
  days      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

/// A mirror of one Stripe subscription. Stripe is the source of truth; this is updated only from verified webhooks.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  /// plus (pro stays hidden)
  plan                 String    @default("plus")
  priceId              String
  /// Stripe's status: incomplete | active | past_due | unpaid | canceled | incomplete_expired
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // "At most one open subscription per person" is a partial unique index in the SQL (Prisma can't describe it).
}

/// One handled Stripe webhook event, by Stripe's event id, so a repeated delivery is never processed twice.
/// Only ids and outcomes are kept: no card, payment or customer details.
model BillingEvent {
  /// Stripe's event id (evt_…)
  id          String    @id
  type        String
  userId      String?
  /// ok | ignored | error: short reason
  outcome     String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type, receivedAt])
}

/// Social feed: one public outfit post. The picture is its own public copy (post-<id>), never a closet or private photo.
model Post {
  id           String   @id @default(cuid())
  userId       String
  imageKey     String
  width        Int
  height       Int
  caption      String?
  /// JSON arrays of short tags.
  styleTags    String   @default("[]")
  occasionTags String   @default("[]")
  /// published | hidden (reported, waiting for review) | removed
  status       String   @default("published")
  likeCount    Int      @default(0)
  saveCount    Int      @default(0)
  reportCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     PostItem[]
  reports   PostReport[]
  reactions PostReaction[]
  saves     PostSave[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// A piece in a post as typed. closetItemId privately notes the closet piece it came from (never shown).
model PostItem {
  id           String  @id @default(cuid())
  postId       String
  position     Int
  name         String
  category     String?
  brand        String?
  store        String?
  link         String?
  imageKey     String?
  closetItemId String?

  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  closetItem ClothingItem? @relation(fields: [closetItemId], references: [id], onDelete: SetNull)

  @@index([postId])
}

/// One person's report of a post; reviewed in the admin dashboard.
model PostReport {
  id         String    @id @default(cuid())
  postId     String
  reporterId String
  /// nudity | harassment | hate | spam | not_mine | other
  reason     String
  note       String?
  /// open | dismissed | actioned
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

/// One reaction per person per post: like (counted and shown) or dislike (private; only shapes that person's feed).
model PostReaction {
  userId    String
  postId    String
  /// like | dislike
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, kind])
}

/// A post someone saved to Saved → Inspiration (private to them).
model PostSave {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
}
