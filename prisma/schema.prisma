generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  selfieUrl    String?
  /// The name shown in the app ("Hello, Maya"). Optional and editable; the email stays the login and can't change.
  displayName  String?
  /// "user" for everyone; "admin" only when set directly in the database (no app path changes it).
  role         String    @default("user")
  /// Updated at most hourly from signed-in requests; powers active-user and retention stats.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  items    ClothingItem[]
  outfits  Outfit[]
  sessions Session[]
  events   AnalyticsEvent[]
  resets   PasswordReset[]
  picks    Pick[]
}

/// One usage event for the owner's analytics dashboard: what happened, never any content.
/// No photos, clothing details, emails or error text are stored here.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  ok         Boolean  @default(true)
  durationMs Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([name, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClothingItem {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  category     String
  layeringRole String   @default("mid_layer")
  warmth       String   @default("medium")
  color        String
  pattern      String
  material     String
  formality    String
  season       String
  description  String
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
}

model Outfit {
  id         String   @id @default(cuid())
  userId     String
  rationale  String
  isFavorite Boolean  @default(false)
  occasion   String?
  weather    String?
  style      String?
  createdAt  DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OutfitItem[]
}

model OutfitItem {
  outfitId String
  itemId   String

  outfit Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}

/// A one-time password reset link. Only a hash of the link's secret is kept.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// "Help me pick": two try-on pictures shared by link so friends can vote A or B. The pictures live in storage
/// under private/picks/<id>/ and are deleted when the pick ends (48 hours, or earlier if the owner ends it).
model Pick {
  id        String    @id @default(cuid())
  /// The long random code in the share link (/pick/<code>).
  code      String    @unique
  userId    String
  labelA    String
  labelB    String
  votesA    Int       @default(0)
  votesB    Int       @default(0)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes PickVote[]

  @@index([userId])
  @@index([expiresAt])
}

/// One friend's vote on a pick. voterId is a random id kept in that browser; nothing else about the voter is stored.
model PickVote {
  pickId    String
  voterId   String
  choice    String
  createdAt DateTime @default(now())

  pick Pick @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@id([pickId, voterId])
}
