generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  selfieUrl    String?
  createdAt    DateTime @default(now())

  items    ClothingItem[]
  outfits  Outfit[]
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClothingItem {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  category     String
  layeringRole String   @default("mid_layer")
  warmth       String   @default("medium")
  color        String
  pattern      String
  material     String
  formality    String
  season       String
  description  String
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
}

model Outfit {
  id         String   @id @default(cuid())
  userId     String
  rationale  String
  isFavorite Boolean  @default(false)
  occasion   String?
  weather    String?
  style      String?
  createdAt  DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OutfitItem[]
}

model OutfitItem {
  outfitId String
  itemId   String

  outfit Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}
