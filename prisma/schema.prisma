generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  selfieUrl    String?
  /// "user" for everyone; "admin" only when set directly in the database (no app path changes it).
  role         String    @default("user")
  /// Updated at most hourly from signed-in requests; powers active-user and retention stats.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  items    ClothingItem[]
  outfits  Outfit[]
  sessions Session[]
  events   AnalyticsEvent[]
}

/// One usage event for the owner's analytics dashboard: what happened, never any content.
/// No photos, clothing details, emails or error text are stored here.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  ok         Boolean  @default(true)
  durationMs Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([name, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClothingItem {
  id           String   @id @default(cuid())
  userId       String
  imageUrl     String
  category     String
  layeringRole String   @default("mid_layer")
  warmth       String   @default("medium")
  color        String
  pattern      String
  material     String
  formality    String
  season       String
  description  String
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
}

model Outfit {
  id         String   @id @default(cuid())
  userId     String
  rationale  String
  isFavorite Boolean  @default(false)
  occasion   String?
  weather    String?
  style      String?
  createdAt  DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OutfitItem[]
}

model OutfitItem {
  outfitId String
  itemId   String

  outfit Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}
